 #!/bin/bash
set -e

# Add your custom logic here

# Read local and remote refs from stdin (Git passes them to pre-push)
while read local_ref local_sha remote_ref remote_sha; do

  # Handle different push cases
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    echo "Remote branch does not exist yet — first push detected."
    # Get all Python files in local commits (since branch creation)
    CHANGED_FILES=$(git diff --name-only --cached -- '*.py')
  elif [ "$local_sha" = "$remote_sha" ]; then
    echo "No new commits to push."
    exit 0
  else
    # Normal push — diff between remote and local
    CHANGED_FILES=$(git diff --name-only "$remote_sha" "$local_sha" -- '*.py')
  fi

  if [ -z "$CHANGED_FILES" ]; then
    echo "No Python files changed."
    exit 0
  fi

  echo "Running code checks on Python files:"
  echo "$CHANGED_FILES"

  # Run Black (formatting)
  # Reformat imports and code: isort then Black (isort first to give Black stable input)
  isort $CHANGED_FILES
  python -m black $CHANGED_FILES --line-length 88

  # Let Ruff apply auto-fixes (including import formatting) so Ruff, isort, and Black agree
  python -m ruff check --fix $CHANGED_FILES || true

  # Run Flake8 (linting) but some line length errors and E203 (slice spacing)
  # are ignored to allow Black-compatible slicing style.
  flake8 $CHANGED_FILES --max-line-length=88 --ignore=E501,W503,E203

  # Final Ruff check to report any remaining problems
  python -m ruff check $CHANGED_FILES

  # Update the virtual environment.
  pip freeze > requirements.txt

done
