{
  "format_version": 1,
  "model_name": "KinematicBicycleModel",
  "dt_seconds": 0.1,
  "state_columns": [
    "x",
    "y",
    "speed",
    "heading"
  ],
  "control_columns": [
    "acceleration",
    "steering_angle"
  ],
  "trajectory_count": 1000,
  "split_counts": {
    "train": 700,
    "eval": 200,
    "validation": 100
  },
  "split_ratio": "7:2:1",
  "seed": 42,
  "trajectory_file_format": "NumPy .npz; trajectories has shape (N, frames, 4)"
}
